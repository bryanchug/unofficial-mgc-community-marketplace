---
/**
 * Plausible Analytics — set PUBLIC_PLAUSIBLE_DOMAIN (e.g. avoda.hvn.ph)
 * in the deployment environment. Script is omitted when unset so local/dev stays quiet.
 */
const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

{domain ? (
	<script
		defer
		data-domain={domain}
		src="https://plausible.io/js/script.js"
	></script>
) : null}
